            </Avatar.Root>
            <VStack align="start" gap={0}>
              <Text fontSize="xs" fontWeight="bold" color="gray.700" _dark={{ color: "gray.200" }} lineClamp={1}>{task.project?.name || 'No Project'}</Text>
              <Text fontSize="10px" color="gray.500">{assigneeName}</Text>
