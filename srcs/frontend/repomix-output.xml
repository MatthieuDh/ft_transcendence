              <LuClock size={12} />
              <Text>{new Date(task.deadline).toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}</Text>
            </HStack>
          )}
        </HStack>
      </Card.Body>
    </Card.Root>
  );
}
