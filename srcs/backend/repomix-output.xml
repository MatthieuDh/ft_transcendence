<body>

<header>
    <div><strong>🚀 Transcendence</strong> | Project Messenger</div>
    <div id="status">🔴 Niet verbonden</div>
</header>

<div class="setup-bar">
    <input type="text" id="jwtToken" placeholder="JWT Token (verplicht)">
    <input type="number" id="userId" placeholder="Mijn User ID">
    <input type="number" id="projectId" placeholder="Project ID">
    <button onclick="enterProject()">Project Betreden</button>
</div>

<div class="chat-container">
    <div id="chat-window">
        <div style="text-align:center; color:#999; margin-top:100px;">Join een project om de chatgeschiedenis te laden...</div>
    </div>
    <div class="input-area">
        <input type="text" id="messageInput" placeholder="Typ een bericht..." disabled onkeypress="if(event.key === 'Enter') sendMessage()">
