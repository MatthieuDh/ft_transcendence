<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <title>Transcendence | Project Chat</title>
    <style>
        :root { --primary: #3498db; --bg: #f5f7f9; --text: #2c3e50; }
        body { font-family: 'Segoe UI', Tahoma, sans-serif; background: var(--bg); color: var(--text); display: flex; flex-direction: column; height: 100vh; margin: 0; }
        
        /* Header & Auth */
        header { background: #1a252f; color: white; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; }
        .setup-bar { background: #fff; padding: 15px 30px; border-bottom: 1px solid #ddd; display: flex; gap: 15px; align-items: center; }
        input, select { padding: 8px; border: 1px solid #ccc; border-radius: 4px; }

        /* Chat Area */
        .chat-container { flex: 1; display: flex; flex-direction: column; max-width: 900px; margin: 20px auto; width: 100%; background: white; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); overflow: hidden; }
        #chat-window { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 10px; background: #fdfdfd; }
        
        /* Messages */
        .message { max-width: 70%; padding: 10px 15px; border-radius: 18px; position: relative; font-size: 14px; line-height: 1.4; }
        .message.others { align-self: flex-start; background: #e9ebee; color: black; border-bottom-left-radius: 2px; }
        .message.mine { align-self: flex-end; background: var(--primary); color: white; border-bottom-right-radius: 2px; }
        .meta { font-size: 10px; margin-bottom: 4px; display: block; font-weight: bold; }
        .time { font-size: 9px; opacity: 0.7; display: block; text-align: right; margin-top: 4px; }

        /* Input Area */
        .input-area { padding: 20px; border-top: 1px solid #eee; display: flex; gap: 10px; }
        #messageInput { flex: 1; padding: 12px; border: 1px solid #ddd; border-radius: 25px; outline: none; }
        button { padding: 10px 25px; background: var(--primary); color: white; border: none; border-radius: 25px; cursor: pointer; font-weight: bold; }
        button:disabled { background: #ccc; }
    </style>
</head>
<body>

<header>
    <div><strong>🚀 Transcendence</strong> | Project Messenger</div>
    <div id="status">🔴 Niet verbonden</div>
</header>

<div class="setup-bar">
    <input type="text" id="jwtToken" placeholder="JWT Token (verplicht)">
    <input type="number" id="userId" placeholder="Mijn User ID">
    <input type="number" id="projectId" placeholder="Project ID">
    <button onclick="enterProject()">Project Betreden</button>
</div>

<div class="chat-container">
    <div id="chat-window">
        <div style="text-align:center; color:#999; margin-top:100px;">Join een project om de chatgeschiedenis te laden...</div>
    </div>
    <div class="input-area">
        <input type="text" id="messageInput" placeholder="Typ een bericht..." disabled onkeypress="if(event.key === 'Enter') sendMessage()">
        <button id="sendBtn" onclick="sendMessage()" disabled>Verstuur</button>
    </div>
</div>

<script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
<script>
    const API_URL = 'http://localhost:3000';
    let socket;
    let currentConfig = { token: '', uId: null, pId: null };

    async function enterProject() {
        currentConfig.token = document.getElementById('jwtToken').value;
        currentConfig.uId = parseInt(document.getElementById('userId').value);
        currentConfig.pId = parseInt(document.getElementById('projectId').value);

        if (!currentConfig.token || !currentConfig.uId || !currentConfig.pId) {
            return alert("Vul alle velden in (Token, User ID, Project ID)");
        }

        // 1. Laad geschiedenis uit DB
        await loadHistory();

        // 2. Verbind via Socket
        connectSocket();

        // 3. UI vrijgeven
        document.getElementById('messageInput').disabled = false;
        document.getElementById('sendBtn').disabled = false;
        document.getElementById('chat-window').innerHTML += `<div style="text-align:center; font-size:12px; color:green;">— Je bent nu live in project ${currentConfig.pId} —</div>`;
    }

    async function loadHistory() {
        const chatWindow = document.getElementById('chat-window');
        try {
            const res = await fetch(`${API_URL}/projects/${currentConfig.pId}/messages`, {
                headers: { 'Authorization': `Bearer ${currentConfig.token}` }
            });
            const messages = await res.json();
            chatWindow.innerHTML = ''; // Clear window
            
            messages.forEach(msg => appendMessage(msg, false));
            chatWindow.scrollTop = chatWindow.scrollHeight;
        } catch (e) {
            console.error("Fout bij laden geschiedenis:", e);
        }
    }

    function connectSocket() {
        if (socket) socket.disconnect();
        socket = io(API_URL, { auth: { token: currentConfig.token } });

        socket.on('connect', () => {
            document.getElementById('status').innerText = '🟢 Verbonden';
            socket.emit('identify', currentConfig.uId);
            socket.emit('joined project', { username: `User_${currentConfig.uId}`, projectId: currentConfig.pId });
        });

        socket.on('new_project_notification', (data) => {
            // Check of het bericht wel bij DIT project hoort
            if (data.projectId === currentConfig.pId) {
                appendMessage(data, true);
            }
        });
    }

    function appendMessage(data, isLive) {
        const chatWindow = document.getElementById('chat-window');
        const isMine = data.userId === currentConfig.uId;
        const name = data.user?.username || `User ${data.userId}`;
        const time = new Date(data.Time || data.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});

        const msgDiv = document.createElement('div');
        msgDiv.className = `message ${isMine ? 'mine' : 'others'}`;
        msgDiv.innerHTML = `
            <span class="meta">${isMine ? 'Jij' : name}</span>
            ${data.content}
            <span class="time">${time}</span>
        `;
        chatWindow.appendChild(msgDiv);
        chatWindow.scrollTop = chatWindow.scrollHeight;
    }

    async function sendMessage() {
        const input = document.getElementById('messageInput');
        const content = input.value;
        if (!content) return;

        try {
            await fetch(`${API_URL}/projects/${currentConfig.pId}/messages`, {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${currentConfig.token}` 
                },
                body: JSON.stringify({ userId: currentConfig.uId, content: content })
            });
            input.value = '';
        } catch (e) {
            alert("Bericht kon niet worden verzonden.");
        }
    }
</script>
</body>
</html>
