                    onlineUsers.delete(data.userId); // Verwijder uit de lijst
                }
                updateOnlineUsersUI(); // Teken het lijstje opnieuw
            }
        });

        // Eerste keer tekenen
        updateNotificationsUI();
        updateOnlineUsersUI();
    </script>
