<file path="srcs/backend/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  USER
  ADMIN
}

enum ProjectRole {
  GUEST
  MEMBER
  PROJECT_LEADER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_EVALUATION
  DONE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                 Int             @id @default(autoincrement())
  username           String          @unique
  email              String         @unique
  password           String?
  googleId           String?         @unique
  intraId            String?         @unique
  githubId           String?         @unique
  globalRole         GlobalRole      @default(USER)
  avatar             String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  sentRequests       Friendship[]    @relation("SentRequests")
  receivedRequests   Friendship[]    @relation("ReceivedRequests")
  projectMemberships ProjectMember[]
  tasks              Task[]          @relation("TaskAssignees")
  notifications Notification[]
  messages           Message[]
  comments            Comment[]
}

model Project {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  deadline    DateTime?
  deadlineNotified Boolean   @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  status      ProjectStatus   @default(PLANNING)
  members     ProjectMember[]
  tasks       Task[]
  messages    Message[]
}

model ProjectMember {
  id        Int         @id @default(autoincrement())
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())
  userId    Int
  projectId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([userId, projectId])
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  deadline    DateTime?
  deadlineNotified Boolean   @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  projectId   Int
  comments Comment[]
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignees   User[]     @relation("TaskAssignees")
  statusHistory TaskStatusHistory[]
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  Time      DateTime @default(now())
  userId    Int
  projectId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING) // Nu is het een strakke Enum!
  createdAt   DateTime         @default(now())

  requester   User             @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("ReceivedRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model Comment {
  id         Int      @id @default(autoincrement())
  content    String
  attachments String[]
  createdAt  DateTime @default(now())

  userId     Int
  taskId     Int

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parentId    Int?
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[] @relation("CommentReplies")
}

model TaskStatusHistory {
  id        Int        @id @default(autoincrement())
  taskId    Int
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status    TaskStatus
  changedAt DateTime   @default(now())
  changedBy Int?
}
