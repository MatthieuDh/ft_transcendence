    <div class="navbar">
        <div class="navbar-brand">🚀 Transcendence</div>
        
        <div class="notification-container" onclick="toggleDropdown(event)">
            <span class="bell-icon">🔔</span>
            <span class="badge" id="badgeCount">0</span>
            
            <div class="dropdown" id="notificationMenu" onclick="event.stopPropagation()">
                <div class="dropdown-header">Recente Meldingen</div>
                <div class="notification-list" id="notificationList">
                    </div>
                <button class="mark-read-btn" onclick="markAllAsRead()">Markeer alles als gelezen</button>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="card">
            <h2>Welkom op het test-dashboard!</h2>
            <p style="margin-top: 10px; color: #555; line-height: 1.6;">
                Dit scherm doet alsof het ingelogd is als <b>User 1</b>. Ga naar je Swagger API en maak een nieuwe taak of voeg User 1 toe aan een project. Het belletje rechtsboven zal dan direct updaten.
            </p>
            <div class="status-badge" id="connStatus">⏳ Verbinden met server...</div>
        </div>
    </div>

    <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
    <script>
        let unreadNotifications = [];
        const badgeCount = document.getElementById('badgeCount');
        const notificationMenu = document.getElementById('notificationMenu');
        const notificationList = document.getElementById('notificationList');
        const connStatus = document.getElementById('connStatus');

        function updateUI() {
            if (unreadNotifications.length > 0) {
                badgeCount.innerText = unreadNotifications.length;
                badgeCount.style.display = 'block';
            } else {
                badgeCount.style.display = 'none';
            }

            notificationList.innerHTML = '';
            if (unreadNotifications.length === 0) {
                notificationList.innerHTML = '<div class="empty-state">Geen nieuwe meldingen.</div>';
            } else {
                unreadNotifications.forEach(notif => {
                    // Update: extra icoontje voor de SYSTEM meldingen (zoals online/offline)
                    let icon = notif.type === 'PROJECT_JOINED' ? '📁' : (notif.type === 'SYSTEM' ? '🤖' : '📋');
                    notificationList.innerHTML += `
                        <div class="dropdown-item">
                            <span class="icon">${icon}</span>
                            <span>${notif.message}</span>
                        </div>`;
                });
            }
        }

        function toggleDropdown(event) {
            event.stopPropagation();
            notificationMenu.style.display = notificationMenu.style.display === 'block' ? 'none' : 'block';
        }

        window.onclick = function() {
            notificationMenu.style.display = 'none';
        }

        // GEÜPDATETE FUNCTIE: Roept nu de backend API aan om de database bij te werken!
        async function markAllAsRead() {
            unreadNotifications = []; 
            updateUI();
            notificationMenu.style.display = 'none';

            try {
                const response = await fetch('http://localhost:3000/notifications/user/1/read', {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });

                if (response.ok) {
                    console.log('✅ Database succesvol geüpdatet: Alles gemarkeerd als gelezen!');
                } else {
                    console.error('❌ Fout bij het updaten van de database');
                }
            } catch (error) {
                console.error('Backend is niet bereikbaar:', error);
            }
        }

        // --- WEBSOCKET LOGICA ---
        const socket = io('http://localhost:3000');
        
        socket.on('connect', () => {
            connStatus.innerHTML = '🟢 Live verbonden met backend (User ID: 1)';
            connStatus.style.background = '#d4edda';
            connStatus.style.color = '#155724';
            socket.emit('identify', 1);
        });

        socket.on('disconnect', () => {
            connStatus.innerHTML = '🔴 Verbinding verbroken...';
            connStatus.style.background = '#f8d7da';
            connStatus.style.color = '#721c24';
        });

        // Luisteren naar normale meldingen (Taken / Projecten)
        socket.on('new_notification', (data) => {
            unreadNotifications.unshift(data); 
            updateUI(); 
        });

        // NIEUW: Luisteren naar statusveranderingen van anderen
        socket.on('user_status_change', (data) => {
            console.log('Status update ontvangen:', data);
            
            // Controleer of de status update niet over onszelf (User 1) gaat
            if (data.userId !== 1) {
                if (data.status === 'ONLINE') {
                    unreadNotifications.unshift({ message: `User ${data.userId} is nu online! 🟢`, type: 'SYSTEM' });
                    updateUI();
                } else if (data.status === 'OFFLINE') {
                    unreadNotifications.unshift({ message: `User ${data.userId} is nu offline. 🔴`, type: 'SYSTEM' });
                    updateUI();
                }
            }
        });

        updateUI();
    </script>
</body>
</html>
