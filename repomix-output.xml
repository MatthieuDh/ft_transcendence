    id: number;
    username: string;
    email: string;
    avatar: string | null;
    globalRole: GlobalRole;
    createdAt: Date;
    projectMembership: ProjectMember[] | null;
}

export interface PromotedUser {
  id: number;
  username: string;
  globalRole: GlobalRole;
}
